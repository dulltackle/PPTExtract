# API 与 worker 必须使用同一版本和同一持久数据根目录。
PPTEXTRACT_CONFIG_VERSION=1
PPTEXTRACT_DATA_ROOT=var/data
PPTEXTRACT_ACTOR_ID=local-operator
PPTEXTRACT_WORKER_ID=worker-1
# 每次更换渲染镜像或锁定工具链契约都必须递增；滚动升级据此拒绝旧 worker 回写。
PPTEXTRACT_RENDER_GENERATION=1
PPTEXTRACT_RENDER_IMAGE=pptextract/document-toolchain:1
# 单次源 PPTX 上传硬上限（字节），默认 128 MiB。
PPTEXTRACT_MAX_SOURCE_UPLOAD_BYTES=134217728
# 瞬时摄取错误的指数退避基础秒数；同一任务最多尝试 3 次。
PPTEXTRACT_JOB_RETRY_BASE_SECONDS=5

# 生产壳层构建目录；开发时由 Vite 在 5173 端口提供页面。
PPTEXTRACT_WEB_DIST=web/dist
